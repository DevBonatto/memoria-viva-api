const db = require('../database/connection');

module.exports = {
    async store(req, res) {
        try {
            const { game_type, time_seconds, errors } = req.body;
            const user_id = req.userId;

            if (!game_type || time_seconds === undefined || errors === undefined) {
                return res.status(400).json({ error: 'Dados incompletos para salvar o ranking.' });
            }

            const baseScore = 10000;
            const finalScore = baseScore - (time_seconds * 10) - (errors * 50);
            
            const score = finalScore < 0 ? 0 : finalScore;

            await db('rankings').insert({
                user_id,
                game_type,
                time_seconds,
                errors,
                score
            });

            return res.status(201).json({ 
                message: 'Pontuação salva com sucesso!', 
                score 
            });

        } catch (error) {
            console.error('Erro ao salvar ranking:', error);
            return res.status(500).json({ error: 'Erro interno ao salvar pontuação.' });
        }
    },

    async index(req, res) {
        try {
            const { game_type } = req.query;

            if (!game_type) {
                return res.status(400).json({ error: 'Informe o tipo de jogo para ver o ranking.' });
            }

            const leaderboard = await db('rankings')
                .join('users', 'users.id', '=', 'rankings.user_id')
                .where('game_type', game_type)
                .select('users.name', 'rankings.score', 'rankings.time_seconds', 'rankings.created_at')
                .orderBy('rankings.score', 'desc')
                .limit(10);

            return res.json(leaderboard);

        } catch (error) {
            console.error('Erro ao buscar ranking:', error);
            return res.status(500).json({ error: 'Erro ao carregar o ranking.' });
        }
    }
};